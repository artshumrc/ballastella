{
	// Workspace-level tooling only: the Playwright config and the browser tests. Each
	// package and app owns its own tsconfig.
	"compilerOptions": {
		"target": "ES2023",
		"module": "Preserve",
		// DOM as well as Node: a Playwright test is Node code, but the bodies of `page.evaluate`
		// are browser code compiled in the same file, and this suite reaches straight for OPFS to
		// seed and inspect a Workspace behind the app's back.
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true
	},
	"include": ["e2e/**/*.ts", "playwright.config.ts"]
}
