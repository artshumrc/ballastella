{
	"name": "@ballastella/editor",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm run stage:viewer && vite dev",
		"build": "pnpm run stage:viewer && vite build",
		"stage:viewer": "pnpm --filter @ballastella/viewer run build && node ../../scripts/stage-viewer-bundle.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@allmaps/maplibre": "catalog:",
		"@allmaps/stdlib": "catalog:",
		"@ballastella/core": "workspace:*",
		"dompurify": "catalog:",
		"maplibre-gl": "catalog:",
		"marked": "catalog:",
		"pmtiles": "catalog:",
		"triiiceratops": "catalog:",
		"wasm-vips": "catalog:"
	},
	"devDependencies": {
		"@ballastella/viewer": "workspace:*",
		"@maplibre/maplibre-gl-style-spec": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"daisyui": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
